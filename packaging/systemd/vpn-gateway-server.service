# Server unit. Install to /etc/systemd/system/ and enable with
#   systemctl enable --now vpn-gateway-server
#
# The server manages containers and serves the trojan listener. It needs to
# reach the container engine's socket, and to bind port 443.

[Unit]
Description=vpn-gateway server
Documentation=https://github.com/vpn-gateway/vpn-gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vpn-gateway-server -config /etc/vpn-gateway/config.yaml
Restart=on-failure
RestartSec=5s

# Credentials for the tunnels live here rather than in the config file.
EnvironmentFile=-/etc/vpn-gateway/credentials.env

StateDirectory=vpn-gateway
StateDirectoryMode=0700

# Binding 443 is the only privileged thing the server does itself; everything
# else is delegated to the container engine.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true

# ProtectSystem=strict mounts everything read-only, so the container engine's
# socket has to be named explicitly. The leading dash keeps the unit starting
# when only one of the two engines is installed.
ReadWritePaths=-/run/docker.sock
ReadWritePaths=-/run/podman/podman.sock
ReadWritePaths=-/var/run/docker.sock

# If the service will not start on your distribution, comment out this whole
# hardening block first and add it back a line at a time. None of it is
# required for the server to work.

[Install]
WantedBy=multi-user.target
